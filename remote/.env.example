# cp .env.example .env して、GPU マシンの管理者に聞いた値を入れる。
# 実行は `uv run --env-file .env trial.py`。.env は自動では読まれない。

# GPU マシン（セッションを作る窓口）
CAPX_ENV_SERVER_URL=http://192.168.0.xx:8200
CAPX_ENV_SERVER_TOKEN=

# LLM（vLLM など OpenAI 互換のエンドポイント）
OPENAI_BASE_URL=http://192.168.0.30:8000/v1
OPENAI_API_KEY=dummy
OPENAI_BASE_MODEL=
CAPX_LLM_WIRE=chat
