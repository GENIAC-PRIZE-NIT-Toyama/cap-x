# cp .env.example .env して、GPU マシンの管理者に聞いた値を入れる。
# 実行は `uv run --env-file .env trial.py`。.env は自動では読まれない。

# GPU マシン（セッションを作る窓口）。管理者に聞いた値を入れる。
CAPX_ENV_SERVER_URL=http://192.168.0.xx:8080

# LLM（vLLM など OpenAI 互換のエンドポイント）
OPENAI_BASE_URL=http://192.168.0.30:8000/v1
OPENAI_API_KEY=dummy
OPENAI_BASE_MODEL=
CAPX_LLM_WIRE=chat
# thinking は既定でオフ（Qwen などに enable_thinking=False を送る）。使うときは 1 にする。
# OpenAI 本家など、知らない項目を拒むサーバのときも 1 にする
# CAPX_LLM_THINKING=1

# Langfuse（任意）。キーがあれば、試行ごとのトレースを送る。管理者に聞いた値を入れる
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
# 誰の実行か（ローマ字。例: Taro Yamada）
CAPX_USER=
