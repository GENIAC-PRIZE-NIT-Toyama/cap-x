# syntax=docker/dockerfile:1.7
#
# LIBERO タスク用の worker。robosuite 用（Dockerfile）と同じ作りで、入れる extra だけが違う。
# robosuite と libero は同じ venv に入らない（pyproject.toml の `[tool.uv] conflicts`）ので、
# image を分ける。backend はタスクの runtime を見て、どちらの image で起動するかを決める。
#
# 1 セッション 1 コンテナの worker。参加者の生成コードが実行されるのはここだけ。
# backend（capx.remote_env.server）が隔離フラグ付きで `docker run` する
# （--cap-drop ALL、--internal ネットワーク、資源の上限）。隔離は起動時に
# かけるので、このファイルは動くイメージを作ることだけを担う。
#
# ビルド前に submodule が要る（リポジトリ直下で）:
#   git submodule update --init capx/third_party/sam3 capx/third_party/LIBERO-PRO \
#       capx/third_party/libero_dependencies/robosuite
#
# ビルド（リポジトリ直下で）:
#   docker build -f docker/worker/Dockerfile.libero -t capx-worker-libero:latest .
FROM python:3.10-slim-bookworm

# libegl1/libopengl0/libglvnd0: MuJoCo の EGL オフスクリーン描画（MUJOCO_GL=egl）
# に GLVND の loader が要る。NVIDIA 側の実体（libEGL_nvidia.so）は、実行時に
# nvidia-container-toolkit が --runtime=nvidia から差し込む。
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    build-essential \
    curl \
    ca-certificates \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libegl1 \
    libopengl0 \
    libglvnd0 \
 && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

WORKDIR /app

# pyproject.toml は capx 自身をインストール対象にしているので、`uv sync` の前に
# ソースが揃っている必要がある（editable で入る）。
COPY pyproject.toml uv.lock README.md ./
COPY capx ./capx
COPY env_configs ./env_configs

# タスクのクラスに埋まっている正解コード（ORACLE_CODE / oracle_code）を取り除く。
# 参加者の生成コードは、このコンテナの中で動く。ファイルが読めれば、正解が写せる。
RUN python - <<'PY'
import ast, pathlib

names = {"ORACLE_CODE", "oracle_code"}
stripped = 0
for path in pathlib.Path("capx/envs/tasks").rglob("*.py"):
    src = path.read_text(encoding="utf-8")
    lines = src.splitlines(keepends=True)
    hits = [
        n for n in ast.walk(ast.parse(src))
        if isinstance(n, ast.Assign)
        and len(n.targets) == 1
        and isinstance(n.targets[0], ast.Name)
        and n.targets[0].id in names
        and isinstance(n.value, ast.Constant)
        and isinstance(n.value.value, str)
    ]
    for n in sorted(hits, key=lambda n: -n.lineno):
        indent = " " * n.col_offset
        lines[n.lineno - 1 : n.end_lineno] = [f"{indent}{n.targets[0].id} = None\n"]
        stripped += 1
    if hits:
        path.write_text("".join(lines), encoding="utf-8")
print("stripped oracle constants:", stripped)
PY

# --frozen は uv.lock のとおりに入れる。lock が pyproject.toml より古いと、
# 足した依存（pyzmq など）が入らないまま起動して落ちる。
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --extra libero

# LIBERO は初回の import で、データの置き場所を対話で聞いてから設定ファイルを作る
# （`libero/libero/__init__.py`）。実行時のコンテナは読み取り専用で、対話もできない。
# ビルド時に既定の場所（N）で作っておく。置き場所は HOME（実行時は /tmp）の外にする。
ENV LIBERO_CONFIG_PATH=/app/.libero
RUN echo n | .venv/bin/python -c "import libero.libero" \
 && test -f /app/.libero/config.yaml

# capx/integrations/motion/pyroki_context.py は Panda の URDF を
# robot_descriptions 経由で取得し、キャッシュが無いと github から git clone する。
# 実行時のコンテナは外へ出られない（--internal）ので、clone は必ず失敗する。
# ネットワークのあるビルド時に温めておく。HOME を /tmp に向ける（下）と
# 既定のキャッシュ先が消えるので、HOME の外に置く。
ENV ROBOT_DESCRIPTIONS_CACHE=/app/.cache/robot_descriptions
RUN .venv/bin/python -c "from robot_descriptions.loaders.yourdfpy import load_robot_description; load_robot_description('panda_description')" \
 && test -d /app/.cache/robot_descriptions/example-robot-data

# 設定やキャッシュを書くライブラリ（mujoco、fontconfig、matplotlib、robosuite の
# private macros）が、イメージの書き込み層ではなく tmpfs に書くようにする。
ENV PATH="/app/.venv/bin:${PATH}" \
    PYTHONUNBUFFERED=1 \
    MUJOCO_GL=egl \
    HOME=/tmp \
    MPLCONFIGDIR=/tmp/matplotlib

# root で動かさない。--read-only と組み合わせるので、書けるのは tmpfs だけ。
# backend の `docker run --user` も同じ値を指定している。
RUN useradd --uid 10001 --no-create-home --shell /usr/sbin/nologin worker
USER 10001:10001

EXPOSE 19500

# 引数は backend が渡す: <config_path> --port --host --session-id
ENTRYPOINT ["python", "-m", "capx.remote_env.worker.server"]
