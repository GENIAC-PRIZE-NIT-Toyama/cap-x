# Copy to .env and fill in before `docker compose up`.
#
# Get GPU UUIDs with:
#   nvidia-smi --query-gpu=index,uuid,name --format=csv

# Physical GPU for the sam3 service (e.g. the RTX 2080 Ti).
SAM3_GPU_UUID=GPU-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Physical GPU for the graspnet service (e.g. the RTX A2000).
GRASPNET_GPU_UUID=GPU-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Only needed if facebook/sam3 on Hugging Face requires authentication to
# download (gated repo). Leave blank otherwise.
HF_TOKEN=
